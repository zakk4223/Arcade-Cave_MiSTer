<misterromdescription>
  <name>Sailor Moon</name>
  <mameversion>0226</mameversion>
  <setname>sailormn</setname>
  <year>1996</year>
  <manufacturer>Gazelle</manufacturer>
  <category>Shooter</category>
  <rotation>vertical (cw)</rotation>
  <region>Japan</region>
  <rbf>cave</rbf>

  <!-- ROM data -->
  <rom index="0" zip="sailormn.zip" md5="none" address="0x30000000">
    <!-- prog ROM -->
    <interleave output="16">
      <part name="bpsm945a.u45" crc="898c9515" map="12"/>
    </interleave>

    <part repeat="0x180000">00</part>

    <interleave output="16">
      <part name="bpsm.u46" crc="32084e80" map="12"/>
    </interleave>


    <!-- EEPROM -->
    <part name="sailormn_europe.nv" crc="59a7dc50" />

    <!-- sound ROM -->
    <part name="bpsm945a.u9" crc="438de548" />

    <!-- PCM ROM OKI1 -->
    <part name="bpsm.u48" crc="498e4ed1" />
    <!-- PCM ROM OKI2 -->
    <part name="bpsm.u47" crc="0f2901b9" />
    <part name="bpsm.u47" crc="0f2901b9" />
    <part name="bpsm.u47" crc="0f2901b9" />
    <part name="bpsm.u47" crc="0f2901b9" />

    <!-- layer 0 -->
    <part name="bpsm.u53" crc="b9b15f83"/>

    <!-- layer 1 -->
    <part name="bpsm.u54" crc="8f00679d" />

    <!-- layer 2 -->
        <interleave output="32">
	<part name="bpsm.u57" crc="86be7b63" map="0301"/>
    	<part name="bpsm.u65" crc="f60fb7b5" map="0010" length="0x100000" />
    	<part name="bpsm.u65" crc="f60fb7b5" map="1000" length="0x100000"/>
	</interleave>
        <interleave output="32">
	<part name="bpsm.u58" crc="e0bba83b" map="0301"/>
    	<part name="bpsm.u65" crc="f60fb7b5" map="0010" offset="0x100000" length="0x100000" />
    	<part name="bpsm.u65" crc="f60fb7b5" map="1000" offset="0x100000" length="0x100000"/>
	</interleave>
        <interleave output="32">
	<part name="bpsm.u62" crc="a1e3bfac" map="0301"/>
    	<part name="bpsm.u64" crc="6559d31c" map="0010" length="0x100000" />
    	<part name="bpsm.u64" crc="6559d31c" map="1000" length="0x100000"/>
	</interleave>
        <interleave output="32">
	<part name="bpsm.u61" crc="6a014b52" map="0301"/>
    	<part name="bpsm.u64" crc="6559d31c" map="0010" offset="0x100000" length="0x100000" />
    	<part name="bpsm.u64" crc="6559d31c" map="1000" offset="0x100000" length="0x100000"/>
	</interleave>
        <interleave output="32">
	<part name="bpsm.u60" crc="992468c0" map="0301"/>
    	<part name="bpsm.u63" crc="d57a56b4" map="0010" length="0x100000" />
    	<part name="bpsm.u63" crc="d57a56b4" map="1000" length="0x100000"/>
	</interleave>




    <!-- sprites -->
    <part name="bpsm.u76" crc="a243a5ba" />
    <part name="bpsm.u77" crc="5179a4ac" />
<!--
    <part name="sprite_desc.bin" crc="13294a05"/>
-->

    <!-- invert screen in EEPROM -->
    <!-- <patch offset="0x00100000">f3 fc</patch> -->
  </rom>

  <!-- select game -->
  <rom index="1">
    <part>09</part>
  </rom>

  <!-- NVRAM -->
  <nvram index="2" size="128" />

  <!-- video timing -->
  
  <rom index="3">
    <part>0141 00f0 0008 0018 0014 0002 0000 0000</part>
  </rom>
  

  <buttons names="Normal/Powerful Shot,Bomber,Full-Auto,-,Start,Coin,Pause" default="A,B,X,R,L,Start" />
</misterromdescription>
