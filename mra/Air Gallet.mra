<misterromdescription>
  <name>Air Gallet</name>
  <mameversion>0226</mameversion>
  <setname>agallet</setname>
  <year>1996</year>
  <manufacturer>Gazelle</manufacturer>
  <category>Shooter</category>
  <rotation>vertical (cw)</rotation>
  <region>Japan</region>
  <rbf>cave</rbf>

  <!-- ROM data -->
  <rom index="0" zip="agallet.zip" md5="none" address="0x30000000">
    <!-- prog ROM -->
    <interleave output="16">
      <part name="bp962a.u45" crc="24815046" map="12"/>
    </interleave>

    <part repeat="0x380000">00</part> 

    <!-- EEPROM -->
    <part name="agallet_europe.nv" crc="ec38bf65" />

    <!-- sound ROM -->
    <part name="bp962a.u9" crc="06caddbe" />

    <!-- PCM ROM OKI1 -->
    <part name="bp962a.u48" crc="ae00a1ce" />
    <!-- PCM ROM OKI2 -->
    <part name="bp962a.u47" crc="6d4e9737" />

    <!-- layer 0 -->
    <part name="bp962a.u53" crc="fcd9a107"/>

    <!-- layer 1 -->
    <part name="bp962a.u54" crc="0cfa3409" />

    <!-- layer 2 -->
        <interleave output="32">
	<part name="bp962a.u57" crc="6d608957" map="0301"/>
    	<part name="bp962a.u65" crc="135fcf9a" map="0010" length="0x100000" />
    	<part name="bp962a.u65" crc="135fcf9a" map="1000" length="0x100000"/>
	</interleave>

    <part repeat="0x1000000">00</part>



    <!-- sprites -->
    <part name="bp962a.u76" crc="858da439" />
    <part name="bp962a.u77" crc="ea2ba35e" />

    <!-- invert screen in EEPROM -->
    <!-- <patch offset="0x00100000">f3 fc</patch> -->
  </rom>

  <!-- select game -->
  <rom index="1">
    <part>08</part>
  </rom>

  <!-- NVRAM -->
  <nvram index="2" size="128" />

  <!-- video timing -->
  
  <rom index="3">
    <part>0141 00f0 0008 0018 0014 0002 0000 0000</part>
  </rom>
  

  <buttons names="Normal/Powerful Shot,Bomber,Full-Auto,-,Start,Coin,Pause" default="A,B,X,R,L,Start" />
</misterromdescription>
